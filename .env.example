# Copy this file to `.env` and fill in your own values.

# Port the API server listens on.
PORT=5000

# MongoDB connection string.
# Local MongoDB:  mongodb://127.0.0.1:27017/blog_platform
# MongoDB Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/blog_platform
MONGODB_URI=mongodb://127.0.0.1:27017/blog_platform

# Secret used to sign JWT tokens. Use a long random string in production.
JWT_SECRET=change_me_to_a_long_random_string

# How long a login token stays valid (e.g. 7d, 1h).
JWT_EXPIRES_IN=7d